{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scanner run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "tool", "method", "status", "started_at", "finished_at", "benchmark_commit", "harness_commit", "command", "tool_version", "engine_version", "configuration", "environment", "exit_code", "source_scope", "coverage_reference", "artifacts", "checksums"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "method": {"enum": ["sast", "dast", "iast"]},
    "status": {"enum": ["PASS", "FAILED_ENV", "FAILED_SCAN", "INVALID_OUTPUT", "INCOMPLETE_COVERAGE", "NOT_RUN"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "benchmark_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "harness_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tool_version": {"type": ["string", "object"]},
    "engine_version": {"type": ["string", "object", "null"]},
    "configuration": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "evidence_path": {"type": ["string", "null"]}
      }
    },
    "environment": {
      "type": "object",
      "required": ["captured_at", "platform", "os", "architecture", "python_version"],
      "properties": {
        "captured_at": {"type": "string", "format": "date-time"},
        "platform": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1}
      }
    },
    "exit_code": {"type": ["integer", "null"]},
    "source_scope": {
      "type": ["object", "null"],
      "required": ["path", "source_path", "source_commit", "tree_sha256", "manifest_sha256", "excluded"],
      "properties": {
        "path": {"const": "tree"},
        "source_path": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest": {"const": "source-scope.json"},
        "excluded": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coverage_reference": {"type": ["string", "null"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "checksums": {"const": "SHA256SUMS"}
  }
}
